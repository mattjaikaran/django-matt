# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/realtime_chat

# Redis (required for WebSockets)
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/gif,application/pdf,text/plain

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_RATE_LIMIT_MESSAGES_PER_SECOND=10
