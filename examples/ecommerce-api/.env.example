# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://ecommerce:ecommerce_secret@db:5432/ecommerce

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Stripe (Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.SMTPBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# AWS S3 (Optional - for media storage in production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Application Settings
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Tax Calculation (placeholder)
TAX_RATE_DEFAULT=0.0875

# Shipping (placeholder)
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=50.00
