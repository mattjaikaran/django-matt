{
  "name": "react-rsbuild-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + RSBuild starter for django-matt APIs — TanStack Router, React Query",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.56.2",
    "@tanstack/react-router": "1.170.4",
    "axios": "1.7.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "1.5.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@rsbuild/core": "1.3.5",
    "@rsbuild/plugin-react": "1.3.0",
    "@tanstack/router-plugin": "1.168.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "tailwindcss": "3.4.12",
    "typescript": "5.6.2"
  }
