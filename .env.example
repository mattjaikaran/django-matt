# Django-Matt Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Django Settings
# =============================================================================
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=tests.settings

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL=postgres://django_matt:django_matt@localhost:5432/django_matt
# Or individual settings:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=django_matt
# POSTGRES_USER=django_matt
# POSTGRES_PASSWORD=django_matt

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
# REDIS_PASSWORD=  # Uncomment for production

# =============================================================================
# Email
# =============================================================================
# Development (Mailhog)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false

# Production (example with SendGrid)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME=3600     # 1 hour in seconds
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days in seconds

# =============================================================================
# OAuth Providers (optional)
# =============================================================================
# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Apple
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# =============================================================================
# Storage (S3-compatible)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=  # For S3-compatible services like MinIO, R2

# =============================================================================
# Billing Providers (optional)
# =============================================================================
# Stripe
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox  # or 'live'

# Polar
# POLAR_API_KEY=
# POLAR_ORGANIZATION_ID=

# =============================================================================
# Monitoring & Logging
# =============================================================================
# Sentry
# SENTRY_DSN=

# Log level
LOG_LEVEL=INFO

# =============================================================================
# Performance
# =============================================================================
# Gunicorn workers (production)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# Celery concurrency
CELERY_CONCURRENCY=4

# =============================================================================
# Docker / Production
# =============================================================================
# TAG=latest
# COMPOSE_PROJECT_NAME=django-matt
